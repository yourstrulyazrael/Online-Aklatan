# MySQL connection. Defaults match XAMPP (user "root", no password).
# For MySQL Server (MySQL80), put the root password you chose during install in DB_PASSWORD.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bookstore

# Signs the login session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
